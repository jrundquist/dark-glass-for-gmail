{
  "manifest_version": 3,
  "name": "Dark Glass for Gmail",
  "version": "1.0.2",
  "description": "Dark mode for Gmail that follows your system, keeps your theme's wallpaper, and stays readable. Frosted dark glass.",
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dark Glass for Gmail",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "css": [
        "src/glass.css"
      ],
      "js": [
        "src/defaults.js",
        "src/color.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://contacts.google.com/widget/*",
        "https://chat.google.com/*",
        "https://calendar.google.com/*",
        "https://keep.google.com/*",
        "https://tasks.google.com/*"
      ],
      "css": [
        "src/frame.css"
      ],
      "js": [
        "src/defaults.js",
        "src/color.js",
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://mail.google.com/*",
    "https://*.googleusercontent.com/*",
    "https://*.gstatic.com/*",
    "https://*.google.com/rd-mail-pt/*"
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
